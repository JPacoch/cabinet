---
import type { SocialProfilesData } from '../lib/profiles';

interface Props {
  profiles: SocialProfilesData;
}

const { profiles } = Astro.props;
const { github, mastodon, substack, x } = profiles;

function getInitials(label: string): string {
  const cleaned = label.replace(/^@/, '').trim();
  const words = cleaned.split(/[\s._-]+/).filter(Boolean);
  if (words.length >= 2) {
    return `${words[0][0]}${words[1][0]}`.toUpperCase();
  }
  return cleaned.slice(0, 2).toUpperCase() || '??';
}

function formatCount(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
  if (n >= 10_000) return `${(n / 1_000).toFixed(1).replace(/\.0$/, '')}k`;
  return n.toLocaleString('en-US');
}

const githubSummary =
  github.bio || [github.company, github.location].filter(Boolean).join(' / ') || undefined;
const githubMeta = [
  typeof github.repos === 'number' ? `${formatCount(github.repos)} ${github.repos === 1 ? 'repo' : 'repos'}` : null,
  typeof github.followers === 'number'
    ? `${formatCount(github.followers)} ${github.followers === 1 ? 'follower' : 'followers'}`
    : null,
].filter((item): item is string => Boolean(item));

const mastodonMeta = [
  typeof mastodon.statuses === 'number'
    ? `${formatCount(mastodon.statuses)} ${mastodon.statuses === 1 ? 'post' : 'posts'}`
    : null,
  typeof mastodon.followers === 'number'
    ? `${formatCount(mastodon.followers)} ${mastodon.followers === 1 ? 'follower' : 'followers'}`
    : null,
].filter((item): item is string => Boolean(item));

const substackTitle = substack.publicationName || substack.name;
const substackMeta = [
  typeof substack.postCount === 'number'
    ? `${formatCount(substack.postCount)} ${substack.postCount === 1 ? 'post' : 'posts'}`
    : 'Newsletter',
].filter((item): item is string => Boolean(item));

const xMeta = [
  typeof x.posts === 'number' ? `${formatCount(x.posts)} ${x.posts === 1 ? 'post' : 'posts'}` : null,
  typeof x.followers === 'number'
    ? `${formatCount(x.followers)} ${x.followers === 1 ? 'follower' : 'followers'}`
    : null,
].filter((item): item is string => Boolean(item));
---

<div id="profile-card" class="profile-card" role="status" aria-hidden="true" hidden>
  <div class="profile-card__inner" data-profile-body></div>
</div>

<template data-profile-tpl="github">
  <div class="pc-social">
    {
      github.contributions && (
        <div class="pc-gh__cal">
          <div class="pc-gh__months">
            {github.contributions.months.map((m) => <span>{m}</span>)}
          </div>
          <div class="pc-gh__grid" aria-hidden="true">
            {github.contributions.weeks.map((week) => (
              <div class="pc-gh__col">
                {week.map((lvl) => (
                  <span class="pc-gh__cell" data-level={lvl} />
                ))}
              </div>
            ))}
          </div>
        </div>
      )
    }

    <div class="pc-social__top">
      <div class="pc-avatar pc-avatar--cabinet" aria-hidden="true">
        <span class="pc-avatar__initials">{getInitials(github.name || github.username)}</span>
        {
          github.avatarUrl && (
            <img
              class="pc-avatar__img"
              src={github.avatarUrl}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )
        }
      </div>
      <span class="pc-badge" aria-label="GitHub">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </span>
    </div>

    <div class="pc-identity">
      <span class="pc-name">{github.name || github.handle}</span>
      {github.name && <span class="pc-handle">@{github.username}</span>}
    </div>

    {githubSummary && <p class="pc-bio">{githubSummary}</p>}
    {!githubSummary && github.status === 'unavailable' && (
      <p class="pc-bio pc-bio--muted">Public profile on GitHub</p>
    )}

    <div class="pc-stats">
      {
        githubMeta.map((item) => (
          <>
            <span><strong>{item}</strong></span>
            <span class="pc-sep" aria-hidden="true">/</span>
          </>
        ))
      }
      <span class="pc-url">{github.displayUrl} ↗</span>
    </div>
  </div>
</template>

<template data-profile-tpl="mastodon">
  <div class="pc-social">
    <div class="pc-social__top">
      <div class="pc-avatar pc-avatar--indigo" aria-hidden="true">
        <span class="pc-avatar__initials">{getInitials(mastodon.name || mastodon.username)}</span>
        {
          mastodon.avatarUrl && (
            <img
              class="pc-avatar__img"
              src={mastodon.avatarUrl}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )
        }
      </div>
      <span class="pc-badge" aria-label="Mastodon">@</span>
    </div>

    <div class="pc-identity">
      <span class="pc-name">{mastodon.name || mastodon.handle}</span>
      {mastodon.name && <span class="pc-handle">{mastodon.handle}</span>}
    </div>

    {mastodon.bio && <p class="pc-bio">{mastodon.bio}</p>}
    {!mastodon.bio && mastodon.status === 'unavailable' && (
      <p class="pc-bio pc-bio--muted">Public profile on {mastodon.instance}</p>
    )}

    <div class="pc-stats">
      {
        mastodonMeta.map((item) => (
          <>
            <span><strong>{item}</strong></span>
            <span class="pc-sep" aria-hidden="true">/</span>
          </>
        ))
      }
      <span class="pc-url">{mastodon.instance} ↗</span>
    </div>
  </div>
</template>

<template data-profile-tpl="substack">
  <div class="pc-social">
    <div class="pc-social__top">
      <div class="pc-avatar pc-avatar--oxblood" aria-hidden="true">
        <span class="pc-avatar__initials">{getInitials(substackTitle || substack.handle)}</span>
        {
          substack.avatarUrl && (
            <img
              class="pc-avatar__img"
              src={substack.avatarUrl}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )
        }
      </div>
      <span class="pc-badge pc-badge--substack" aria-label="Substack">
        <svg width="11" height="11" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M2 2h12v2H2V2zm0 3.5h12v2H2v-2zM2 9h12v5.5l-6-3.2-6 3.2V9z" />
        </svg>
      </span>
    </div>

    <div class="pc-identity">
      <span class="pc-name">{substackTitle || substack.handle}</span>
      {substackTitle && <span class="pc-handle">{substack.handle}</span>}
    </div>

    {substack.bio && <p class="pc-bio">{substack.bio}</p>}
    {!substack.bio && substack.status === 'unavailable' && (
      <p class="pc-bio pc-bio--muted">Substack publication</p>
    )}

    {
      substack.latestPostTitle && (
        <div class="pc-latest">
          <span class="pc-latest__label">
            Latest{substack.latestPostDate ? ` / ${substack.latestPostDate}` : ''}
          </span>
          <span class="pc-latest__title">{substack.latestPostTitle}</span>
        </div>
      )
    }

    <div class="pc-stats">
      {
        substackMeta.map((item) => (
          <>
            <span><strong>{item}</strong></span>
            <span class="pc-sep" aria-hidden="true">/</span>
          </>
        ))
      }
      <span class="pc-url">{substack.displayUrl} ↗</span>
    </div>
  </div>
</template>

<template data-profile-tpl="x">
  <div class="pc-social">
    <div class="pc-social__top">
      <div class="pc-avatar pc-avatar--warm" aria-hidden="true">
        <span class="pc-avatar__initials">{getInitials(x.name || x.username)}</span>
        {
          x.avatarUrl && (
            <img
              class="pc-avatar__img"
              src={x.avatarUrl}
              alt=""
              width="36"
              height="36"
              loading="lazy"
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )
        }
      </div>
      <span class="pc-badge" aria-label="X">𝕏</span>
    </div>

    <div class="pc-identity">
      <span class="pc-name">{x.name || x.handle}</span>
      {
        x.verifiedType && x.verifiedType !== 'none' && (
          <svg class="pc-verified" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="10" fill="currentColor" />
            <path d="M8.5 12.3l2.3 2.3 4.8-5.1" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
          </svg>
        )
      }
      {x.name && <span class="pc-handle">{x.handle}</span>}
    </div>

    {x.bio && <p class="pc-bio">{x.bio}</p>}
    {!x.bio && x.status === 'unavailable' && (
      <p class="pc-bio pc-bio--muted">Public profile on X</p>
    )}

    <div class="pc-stats">
      {
        xMeta.map((item) => (
          <>
            <span><strong>{item}</strong></span>
            <span class="pc-sep" aria-hidden="true">/</span>
          </>
        ))
      }
      <span class="pc-url">{x.displayUrl} ↗</span>
    </div>
  </div>
</template>

<style>
  .profile-card {
    position: fixed;
    z-index: 125;
    left: 0;
    top: 0;
    pointer-events: none;
    will-change: transform;
  }

  .profile-card[hidden] {
    display: none;
  }

  .profile-card__inner {
    width: min(18.5rem, calc(100vw - 1.5rem));
    padding: 0.9rem;
    border-radius: 16px;
    background: var(--tooltip-bg);
    color: var(--tooltip-ink);
    box-shadow: var(--tooltip-shadow), var(--shadow-float);
    -webkit-backdrop-filter: blur(22px) saturate(1.85);
    backdrop-filter: blur(22px) saturate(1.85);
    font-family: var(--font-sans);
    transform-origin: 50% 100%;
    will-change: transform, opacity;
  }

  .profile-card[data-pos='below'] .profile-card__inner {
    transform-origin: 50% 0%;
  }

  :global(.pc-gh__cal) {
    margin-bottom: 0.75rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  :global(.pc-gh__months) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-bottom: 0.35rem;
    font-family: var(--font-secondary);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--muted);
  }

  :global(.pc-gh__grid) {
    display: grid;
    grid-template-columns: repeat(14, 1fr);
    gap: 3px;
  }

  :global(.pc-gh__col) {
    display: grid;
    grid-template-rows: repeat(7, 1fr);
    gap: 3px;
  }

  :global(.pc-gh__cell) {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 2.5px;
    background: rgba(128, 128, 124, 0.14);
  }

  :global(.pc-gh__cell[data-level='1']) {
    background: #9be9a8;
  }
  :global(.pc-gh__cell[data-level='2']) {
    background: #40c463;
  }
  :global(.pc-gh__cell[data-level='3']) {
    background: #30a14e;
  }
  :global(.pc-gh__cell[data-level='4']) {
    background: #216e39;
  }

  :global(:root[data-theme='dark'] .pc-gh__cell) {
    background: rgba(255, 255, 255, 0.08);
  }
  :global(:root[data-theme='dark'] .pc-gh__cell[data-level='1']) {
    background: #0e4429;
  }
  :global(:root[data-theme='dark'] .pc-gh__cell[data-level='2']) {
    background: #006d32;
  }
  :global(:root[data-theme='dark'] .pc-gh__cell[data-level='3']) {
    background: #26a641;
  }
  :global(:root[data-theme='dark'] .pc-gh__cell[data-level='4']) {
    background: #39d353;
  }

  :global(.pc-social__top) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.55rem;
  }

  :global(.pc-avatar) {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--r-pill);
    overflow: hidden;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.22),
      0 0 0 1px var(--line);
  }

  :global(.pc-avatar__initials) {
    user-select: none;
  }

  :global(.pc-avatar__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  :global(.pc-avatar--cabinet) {
    background: linear-gradient(135deg, #27272a, #881337 85%);
  }

  :global(.pc-avatar--warm) {
    background: radial-gradient(circle at 28% 28%, #fb7185, #881337 62%, #1f2937 100%);
  }

  :global(.pc-avatar--oxblood) {
    background: linear-gradient(145deg, #9f1239, #4c0519);
  }

  :global(.pc-avatar--indigo) {
    background: linear-gradient(135deg, #4f46e5, #881337);
  }

  :global(.pc-badge) {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    background: var(--line);
    color: var(--ink-2);
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 600;
  }

  :global(.pc-badge--substack) {
    color: #ff6719;
  }

  :global(.pc-identity) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem;
    margin-bottom: 0.3rem;
    line-height: 1.25;
  }

  :global(.pc-name) {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--tooltip-ink);
  }

  :global(.pc-verified) {
    color: #1d9bf0;
    flex-shrink: 0;
    align-self: center;
  }

  :global(.pc-handle) {
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    color: var(--muted);
    letter-spacing: -0.005em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }

  :global(.pc-bio) {
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.pc-bio--muted) {
    color: var(--muted);
  }

  :global(.pc-latest) {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-bottom: 0.6rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }

  :global(.pc-latest__label) {
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  :global(.pc-latest__title) {
    font-size: 0.76rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--tooltip-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  :global(.pc-stats) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-secondary);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }

  :global(.pc-stats strong) {
    font-weight: 600;
    color: var(--tooltip-ink);
  }

  :global(.pc-sep) {
    opacity: 0.6;
  }

  :global(.pc-url) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>

<script>
  let pcAbort: AbortController | null = null;
  let pcRafId: number | null = null;

  function clamp(val: number, min: number, max: number): number {
    return Math.max(min, Math.min(val, max));
  }

  function initProfileCards() {
    pcAbort?.abort();
    if (pcRafId !== null) {
      cancelAnimationFrame(pcRafId);
      pcRafId = null;
    }
    pcAbort = new AbortController();
    const { signal } = pcAbort;

    const card = document.getElementById('profile-card') as HTMLElement | null;
    const body = card?.querySelector('[data-profile-body]') as HTMLElement | null;
    if (!card || !body) return;

    const canHover = () => window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const prefersReduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let activeLink: HTMLElement | null = null;
    let showTimer: number | null = null;

    let lastMouseX: number | null = null;
    let lastMoveTime = performance.now();
    let pointerVx = 0;

    let currentX = 0;
    let targetX = 0;
    let velX = 0;
    let anchorY = 0;
    let posMode: 'above' | 'below' = 'above';

    let sway = 0;
    let velSway = 0;
    let scale = 1;
    let velScale = 0;
    let opacity = 0;
    let lastFrameTime = performance.now();

    const computeBounds = (el: HTMLElement, clientX: number | null) => {
      const rect = el.getBoundingClientRect();
      const margin = 12;
      const cardH = body.offsetHeight || 160;
      const halfW = (body.offsetWidth || 260) / 2;

      const rawX = clientX !== null && clientX > 0 ? clientX : rect.left + rect.width / 2;
      const clampedX = clamp(
        rawX,
        margin + halfW,
        Math.max(margin + halfW, window.innerWidth - margin - halfW)
      );

      let top = rect.top - cardH - 12;
      let pos: 'above' | 'below' = 'above';
      if (top < margin) {
        top = rect.bottom + 12;
        pos = 'below';
      }
      return { clampedX, top, pos };
    };

    const applyTransform = () => {
      const dir = posMode === 'above' ? 1 : -1;
      const rotateDeg = prefersReduced() ? 0 : clamp(-sway * 0.36 * dir, -3.8, 3.8);
      const skewDeg = prefersReduced() ? 0 : clamp(sway * 0.55 * dir, -5.2, 5.2);
      const sc = prefersReduced() ? 1 : scale;

      card.dataset.pos = posMode;
      card.style.transform = `translate3d(${currentX.toFixed(2)}px, ${anchorY.toFixed(2)}px, 0) translateX(-50%)`;
      body.style.transform = `rotate(${rotateDeg.toFixed(2)}deg) skewX(${skewDeg.toFixed(2)}deg) scale(${sc.toFixed(4)})`;
      body.style.opacity = `${opacity.toFixed(3)}`;
    };

    const stepLoop = (now: number) => {
      pcRafId = null;
      if (card.hidden || !activeLink) return;

      const dt = clamp((now - lastFrameTime) / 1000, 0.004, 0.032);
      lastFrameTime = now;

      if (prefersReduced()) {
        currentX = targetX;
        velX = 0;
        sway = 0;
        velSway = 0;
        scale = 1;
        velScale = 0;
        opacity = 1;
        applyTransform();
        return;
      }

      const posF = 230 * (targetX - currentX) - 20 * velX;
      velX += posF * dt;
      currentX += velX * dt;

      const targetSway = clamp((targetX - currentX) * 0.32 + velX * 0.015, -8, 8);
      const swayF = 195 * (targetSway - sway) - 12.5 * velSway;
      velSway += swayF * dt;
      sway += velSway * dt;

      const scaleF = 360 * (1 - scale) - 21 * velScale;
      velScale += scaleF * dt;
      scale += velScale * dt;

      opacity = Math.min(1, opacity + dt * 9);
      applyTransform();

      const settled =
        Math.abs(targetX - currentX) < 0.06 &&
        Math.abs(velX) < 0.25 &&
        Math.abs(sway) < 0.06 &&
        Math.abs(velSway) < 0.15 &&
        Math.abs(1 - scale) < 0.002 &&
        opacity >= 0.999;

      if (!settled) {
        pcRafId = requestAnimationFrame(stepLoop);
      }
    };

    const ensureLoop = () => {
      if (pcRafId === null && !card.hidden) {
        lastFrameTime = performance.now();
        pcRafId = requestAnimationFrame(stepLoop);
      }
    };

    const hide = () => {
      if (showTimer !== null) {
        window.clearTimeout(showTimer);
        showTimer = null;
      }
      if (pcRafId !== null) {
        cancelAnimationFrame(pcRafId);
        pcRafId = null;
      }
      activeLink = null;
      body.textContent = '';
      card.hidden = true;
    };

    const showFor = (link: HTMLElement) => {
      const key = link.dataset.profileCard;
      const tpl = key ? (document.querySelector(`[data-profile-tpl="${key}"]`) as HTMLTemplateElement | null) : null;
      if (!tpl) return;

      const wasHidden = card.hidden || activeLink !== link;
      activeLink = link;
      body.replaceChildren(tpl.content.cloneNode(true));
      body.querySelectorAll('img.pc-avatar__img').forEach((img) => {
        img.addEventListener('error', () => img.remove(), { once: true });
      });
      card.hidden = false;

      const { clampedX, top, pos } = computeBounds(link, lastMouseX);
      targetX = clampedX;
      anchorY = top;
      posMode = pos;

      if (wasHidden) {
        currentX = clampedX;
        velX = clamp(pointerVx * 0.3, -300, 300);
        sway = prefersReduced() ? 0 : clamp(pointerVx * 0.008, -3.5, 3.5);
        velSway = 0;
        scale = prefersReduced() ? 1 : 0.88;
        velScale = prefersReduced() ? 0 : 1.2;
        opacity = prefersReduced() ? 1 : 0;
      }

      applyTransform();
      ensureLoop();
    };

    const links = Array.from(document.querySelectorAll('[data-profile-card]')) as HTMLElement[];
    links.forEach((link) => {
      link.addEventListener(
        'mouseenter',
        (e) => {
          if (!canHover()) return;
          lastMouseX = e.clientX;
          if (showTimer !== null) window.clearTimeout(showTimer);
          showTimer = window.setTimeout(() => showFor(link), 70);
        },
        { signal }
      );

      link.addEventListener(
        'mousemove',
        (e) => {
          const now = performance.now();
          const elapsed = Math.max(4, now - lastMoveTime);
          if (lastMouseX !== null) {
            pointerVx = clamp(((e.clientX - lastMouseX) / elapsed) * 1000, -1400, 1400);
          }
          lastMouseX = e.clientX;
          lastMoveTime = now;

          if (activeLink === link && !card.hidden) {
            const { clampedX, top, pos } = computeBounds(link, lastMouseX);
            targetX = clampedX;
            anchorY = top;
            posMode = pos;
            ensureLoop();
          }
        },
        { passive: true, signal }
      );

      link.addEventListener('mouseleave', hide, { signal });
      link.addEventListener('click', hide, { signal });
    });

    window.addEventListener('scroll', hide, { passive: true, signal });
    window.addEventListener('blur', hide, { signal });
    document.addEventListener('astro:before-swap', hide, { signal });
  }

  document.addEventListener('astro:page-load', initProfileCards);
</script>
