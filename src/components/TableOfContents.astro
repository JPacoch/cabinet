---
import type { TocHeading } from '../lib/markdown';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
const showToc = headings.length >= 2;
---

{
  showToc && (
    <>
      {/* Mobile subtle inline disclosure */}
      <details class="toc-mobile enter" style="--d: 2" data-toc-mobile>
        <summary class="toc-mobile__summary">
          <span class="kicker">Contents</span>
          <span class="toc-mobile__current" data-toc-mobile-current>
            {headings[0]?.text}
          </span>
          <svg
            class="toc-mobile__chevron"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </summary>
        <nav class="toc-mobile__nav" aria-label="Table of contents">
          <ol class="toc-list">
            {headings.map((h, idx) => (
              <li class={`toc-item toc-item--l${h.level}`}>
                <a
                  href={`#${h.id}`}
                  class={`toc-link${idx === 0 ? ' is-active' : ''}`}
                  data-toc-link={h.id}
                >
                  <span class="toc-dash" aria-hidden="true"></span>
                  <span class="toc-text">{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </details>

      {/* Desktop quiet sticky margin Table of Contents */}
      <aside class="toc-desktop" aria-label="Table of contents">
        <nav class="toc-desktop__nav enter" style="--d: 2">
          <ol class="toc-list" data-toc-list>
            {headings.map((h, idx) => (
              <li class={`toc-item toc-item--l${h.level}`}>
                <a
                  href={`#${h.id}`}
                  class={`toc-link${idx === 0 ? ' is-active' : ''}`}
                  data-toc-link={h.id}
                  title={h.text}
                >
                  <span class="toc-dash" aria-hidden="true"></span>
                  <span class="toc-text">{h.text}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    </>
  )
}

<style>
  /* Mobile inline ToC */
  .toc-mobile {
    display: block;
    margin-bottom: var(--s-6);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .toc-mobile__summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.72rem 0;
    cursor: pointer;
    list-style: none;
  }

  .toc-mobile__summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile__current {
    font-size: var(--text-xs);
    color: var(--ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
  }

  .toc-mobile__chevron {
    width: 14px;
    height: 14px;
    color: var(--muted);
    flex-shrink: 0;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .toc-mobile[open] .toc-mobile__chevron {
    transform: rotate(180deg);
  }

  .toc-mobile__nav {
    padding: 0.25rem 0 0.85rem;
  }

  /* Shared bare link list */
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .toc-item--l3 {
    padding-left: 0.75rem;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.8125rem;
    line-height: 1.45;
    padding: 0.16rem 0;
    color: var(--muted);
    transition: color var(--dur-2) ease, transform var(--dur-2) var(--ease-out);
  }

  .toc-dash {
    flex-shrink: 0;
    width: 7px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
    transition: width var(--dur-2) var(--ease-out), opacity var(--dur-2) ease,
      height var(--dur-1) ease;
  }

  .toc-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .toc-link:hover {
    color: var(--ink);
  }

  .toc-link.is-active {
    color: var(--accent);
    font-weight: 500;
  }

  .toc-link.is-active .toc-dash {
    width: 15px;
    height: 1.5px;
    opacity: 1;
  }

  /* Desktop margin rail — detached in wide left space */
  .toc-desktop {
    display: none;
  }

  @media (min-width: 1080px) {
    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
      position: fixed;
      top: 50%;
      left: clamp(1.25rem, 3.2vw, 3.25rem);
      transform: translateY(-50%);
      width: min(12.5rem, calc((100vw - var(--prose)) / 2 - 2.5rem));
      max-height: 62svh;
      overflow-y: auto;
      z-index: 20;
    }
  }

  @media (min-width: 1080px) and (max-width: 1179px) {
    .toc-desktop {
      position: sticky;
      top: 5rem;
      transform: none;
      left: auto;
      width: auto;
      align-self: start;
      max-height: calc(100svh - 8rem);
    }
  }
</style>

<script>
  let tocAbort: AbortController | null = null;
  let tocObserver: IntersectionObserver | null = null;

  function initTableOfContents() {
    tocAbort?.abort();
    tocAbort = new AbortController();
    tocObserver?.disconnect();

    const { signal } = tocAbort;
    const mobileDetails = document.querySelector('[data-toc-mobile]') as HTMLDetailsElement | null;
    const mobileCurrent = document.querySelector('[data-toc-mobile-current]') as HTMLElement | null;
    const allLinks = Array.from(document.querySelectorAll('[data-toc-link]')) as HTMLAnchorElement[];

    if (allLinks.length === 0) return;

    const headingIds = Array.from(new Set(allLinks.map((a) => a.dataset.tocLink!)));
    const headings = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => Boolean(el));

    if (headings.length === 0) return;

    let activeId = headings[0].id;

    const setActive = (id: string) => {
      if (activeId === id && allLinks.some((l) => l.dataset.tocLink === id && l.classList.contains('is-active'))) {
        return;
      }
      activeId = id;
      allLinks.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.tocLink === id);
      });
      const activeHeading = headings.find((h) => h.id === id);
      if (mobileCurrent && activeHeading) {
        mobileCurrent.textContent = activeHeading.textContent ?? '';
      }
    };

    allLinks.forEach((link) => {
      link.addEventListener(
        'click',
        () => {
          const targetId = link.dataset.tocLink;
          if (targetId) {
            setActive(targetId);
          }
          if (mobileDetails?.open) {
            mobileDetails.open = false;
          }
        },
        { signal }
      );
    });

    const syncFromScroll = () => {
      const triggerY = 180;
      let current = headings[0].id;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= triggerY) {
          current = h.id;
        }
      }
      setActive(current);
    };

    const visibleHeadings = new Set<string>();

    tocObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            visibleHeadings.add(entry.target.id);
          } else {
            visibleHeadings.delete(entry.target.id);
          }
        });

        const firstVisible = headings.find((h) => visibleHeadings.has(h.id));
        if (firstVisible) {
          setActive(firstVisible.id);
        } else {
          syncFromScroll();
        }
      },
      {
        rootMargin: '-80px 0px -60% 0px',
        threshold: 0,
      }
    );

    headings.forEach((h) => tocObserver!.observe(h));

    let scrollTick = false;
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollTick) {
          requestAnimationFrame(() => {
            syncFromScroll();
            scrollTick = false;
          });
          scrollTick = true;
        }
      },
      { passive: true, signal }
    );

    requestAnimationFrame(() => syncFromScroll());
  }

  document.addEventListener('astro:page-load', initTableOfContents);
</script>
