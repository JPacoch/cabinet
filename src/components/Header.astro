---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const isWriting = currentPath.startsWith('/writing');
const isAbout = currentPath.startsWith('/about');
---

<header class="site-header">
  <div class="wrap">
    <div class="col-wide site-header__inner">
      <a class="brand-mark" href="/" transition:name="brand-mark">From the Cabinet</a>

      <nav class="nav" aria-label="Primary">
        <a
          class="nav__link"
          href="/writing/"
          aria-current={isWriting ? 'page' : undefined}
        >
          Writing
        </a>
        <a
          class="nav__link nav__link--optional"
          href="https://quotes.fromthecabinet.com/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Quotes ↗
        </a>
        <a
          class="nav__link"
          href="/about/"
          aria-current={isAbout ? 'page' : undefined}
        >
          About
        </a>

        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Toggle color theme"
          title="Toggle color theme"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4.5" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
        </button>
      </nav>
    </div>
  </div>
</header>
